-- | Treat any RoomObject as a plain `RoomObject`. Free at runtime.
toRoomObject :: forall a. IsRoomObject a => a -> RoomObject
toRoomObject = unsafeCoerce

-- | Treat any structure as a plain `Structure`. Free at runtime.
toStructure :: forall a. IsStructure a => a -> Structure
toStructure = unsafeCoerce

-- | Treat any owned structure as a plain `OwnedStructure`. Free at runtime.
toOwnedStructure :: forall a. IsOwnedStructure a => a -> OwnedStructure
toOwnedStructure = unsafeCoerce

-- | Treat a `Creep` or `PowerCreep` as `AnyCreep`. Free at runtime.
toAnyCreep :: forall a. IsCreep a => a -> AnyCreep
toAnyCreep = unsafeCoerce

foreign import instanceOfImpl :: forall a. Fn2 String a Boolean

-- | Narrow a mixed value (`RoomObject`, `Structure`, `OwnedStructure`, `AnyCreep`,
-- | e.g. a result of `FIND_STRUCTURES`) to a concrete type with a JS `instanceof`
-- | check: `downcast s :: Maybe StructureTower`.
downcast :: forall a b. IsRoomObject b => RoomObjectClass a => b -> Maybe a
downcast x
  | runFn2 instanceOfImpl (className (Proxy :: Proxy a)) x = Just (unsafeCoerce x)
  | otherwise = Nothing
